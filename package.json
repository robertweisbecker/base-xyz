{
  "name": "base-stylex-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --report-unused-disable-directives --ignore-pattern '.worktrees/**'",
    "lint:fix": "oxlint --fix --report-unused-disable-directives --ignore-pattern '.worktrees/**'",
    "doctor": "react-doctor --no-telemetry",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:quick": "npm run typecheck && npm run lint && npm run format:check",
    "verify:full": "npm run verify:quick && npm run test:stylex-dev && npm run test:app && npm run test:storybook && npm run test:style-props:bundle",
    "test:storybook": "npm run build-storybook && playwright test",
    "test:style-props": "npm run build-storybook && playwright test tests/style-props && npm run test:style-props:bundle",
    "test:style-props:bundle": "node tests/style-props/bundle-boundary.mjs",
    "test:stylex-dev": "node tests/stylex-dev-cold-start.mjs",
    "test:app": "npm run build && playwright test --config playwright.app.config.ts",
    "preview": "vite preview",
    "storybook": "WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "vite preview --outDir storybook-static --port 6006"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/atoms": "^0.19.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.4",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.9.13",
    "storybook": "^10.5.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
