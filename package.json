{
  "name": "base-stylex-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && npm run lint:stylex",
    "lint:stylex": "eslint src",
    "test:theme-props": "npm run build-storybook && playwright test && npm run test:theme-props:bundle",
    "test:theme-props:bundle": "node tests/theme-props/bundle-boundary.mjs",
    "preview": "vite preview",
    "storybook": "WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "vite preview --outDir storybook-static --port 6006"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.2.7",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.8.0",
    "oxlint": "^1.71.0",
    "storybook": "^10.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1"
  }
}
